rules_version = '2';

// =============================================================================
// SECURITY RULES — the real gatekeeper (the UI only hides buttons).
// Keep in sync with src/config/permissions.ts.
// Deploy: Firebase console › Firestore › Rules › paste › Publish
//     or: firebase deploy --only firestore:rules
//
// Spark (free) plan note: there are no Cloud Functions, so bills are calculated on the
// cashier device inside a transaction from the saved order. These rules make sure only
// cashier/admin can take payments, payments can never be edited or deleted, and every
// payment records who took it (see auditLogs).
// =============================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers
    function signedIn() { return request.auth != null; }
    function staffPath() { return /databases/$(database)/documents/staff/$(request.auth.uid); }
    function me() { return get(staffPath()).data; }
    function isStaff() { return signedIn() && exists(staffPath()) && me().active == true; }
    function hasRole(roles) { return isStaff() && me().role in roles; }
    function isAdmin() { return hasRole(['owner', 'admin']); }
    function frontOfHouse() { return hasRole(['owner', 'admin', 'cashier', 'waiter']); }
    function canTakePayment() { return hasRole(['owner', 'admin', 'cashier']); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ---------------------------------------------------------------- settings & menu (admin edits)
    match /settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /categories/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /products/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    match /modifierGroups/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------- staff
    // Readable without login so the login screen can list names. Holds no secrets
    // (PINs live in Firebase Auth, never in Firestore).
    match /staff/{uid} {
      allow read: if true;
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------------------------------------------------------------- floor
    match /tables/{id} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      // Staff change status; only admin changes layout (label, size, position)
      allow update: if frontOfHouse()
        && (isAdmin() || !changed().hasAny(['label', 'area', 'seats', 'shape', 'x', 'y', 'w', 'h']));
    }

    // Order / receipt number counters: may only go up by exactly 1
    match /counters/{id} {
      allow read: if isStaff();
      allow create: if frontOfHouse() && request.resource.data.value is int;
      allow update: if frontOfHouse() && request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // ---------------------------------------------------------------- orders
    match /orders/{id} {
      allow read: if isStaff();
      allow create: if frontOfHouse()
        && request.resource.data.status == 'new'
        && request.resource.data.paidCents == 0
        && request.resource.data.discountPercent == 0;
      allow update: if
        // kitchen: only ticket progress
        (hasRole(['kitchen'])
          && changed().hasOnly(['tickets', 'status', 'updatedAt'])
          && (request.resource.data.status in ['new', 'preparing', 'ready']
              || request.resource.data.status == resource.data.status))
        // waiters: anything except money fields, and never mark paid
        || (frontOfHouse()
          && !changed().hasAny(['paidCents', 'paidAt', 'discountPercent'])
          && request.resource.data.status != 'paid')
        // cashier / admin / owner: payments and discounts
        || canTakePayment();
      allow delete: if false;
    }

    match /tickets/{id} {
      allow read: if isStaff();
      allow create: if frontOfHouse();
      allow update: if isStaff();
      allow delete: if false;
    }

    // ---------------------------------------------------------------- money (append-only)
    match /payments/{id} {
      allow read: if isStaff();
      allow create: if canTakePayment() && request.resource.data.cashierId == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------- printing
    match /printJobs/{id} {
      allow read: if isStaff();
      // Reprints (id starts with "reprint_") are admin only
      allow create: if isStaff()
        && request.resource.data.status == 'pending'
        && (!id.matches('reprint_.*') || isAdmin());
      // Cashier may retry a failed job or confirm an uncertain one printed
      allow update: if canTakePayment()
        && changed().hasOnly(['status', 'error', 'updatedAt'])
        && request.resource.data.status in ['pending', 'printed'];
      allow delete: if false;
    }

    // Print agent heartbeat — written by the agent with the Admin SDK (bypasses rules)
    match /agents/{id} {
      allow read: if isStaff();
      allow write: if false;
    }

    // ---------------------------------------------------------------- audit
    match /auditLogs/{id} {
      allow create: if isStaff() && request.resource.data.staffId == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }
  }
}
